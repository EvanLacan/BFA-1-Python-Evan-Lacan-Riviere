print("Somme totale (WHILE) :", somme_while)

import urllib.request
import json
import csv
from pathlib import Path

# ==========================================
# 1. Taux du jour
# ==========================================
print("--- 1. Appel de l'API (Taux du jour) ---")
url_latest = "https://api.frankfurter.app/latest?from=EUR&to=USD"

# urllib envoie la requête à l'adresse web
with urllib.request.urlopen(url_latest) as reponse_web:
    # On lit le texte brut, puis json.loads le transforme en dictionnaire Python
    data_latest = json.loads(reponse_web.read().decode())
    print(f"Le {data_latest['date']}, le taux EUR/USD est de {data_latest['rates']['USD']}")

# ==========================================
# 2. Série sur une période et sauvegarde
# ==========================================
print("\n--- 2. Historique et création des fichiers ---")
url_historique = "https://api.frankfurter.app/2026-01-01..2026-09-01?from=EUR&to=USD"

with urllib.request.urlopen(url_historique) as reponse_web:
    data_historique = json.loads(reponse_web.read().decode())

# Création automatique des dossiers demandés par l'enseignante
Path("cache").mkdir(exist_ok=True)
Path("donnees").mkdir(exist_ok=True)

# Sauvegarde de la réponse brute en JSON dans le dossier cache
with open("cache/reponse_brute.json", "w") as fichier_json:
    json.dump(data_historique, fichier_json)
print("Fichier JSON enregistré dans cache/reponse_brute.json")

# Traitement de la donnée et sauvegarde en CSV propre
with open("donnees/taux_historique.csv", "w", newline='') as fichier_csv:
    writer = csv.writer(fichier_csv)
    # Écriture de la ligne d'en-tête (les noms des colonnes)
    writer.writerow(["Date", "Taux_USD"])
   
    # On boucle sur le dictionnaire "rates" qui contient les dates en clés
    for date, valeurs in data_historique["rates"].items():
        taux = valeurs["USD"] # On extrait le taux spécifique à l'USD
        writer.writerow([date, taux]) # On écrit la ligne dans le fichier

print("Fichier CSV enregistré dans donnees/taux_historique.csv")